AUTH_SECRET="change-me-in-production"
DATABASE_URL="file:./dev.db"

# Media — Cloudinary (recomendado em produção)
# Opção A:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Opção B (URL do quickstart Cloudinary):
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Media — Vercel Blob (legado; opcional se Cloudinary estiver configurado)
# BLOB_READ_WRITE_TOKEN=""

# Turso (produção Vercel)
# TURSO_DATABASE_URL="libsql://....turso.io"
# TURSO_AUTH_TOKEN=""

# Destino de candidaturas / inscrições / contacto
REGISTRATION_EMAIL="elemos@unilicungo.ac.mz"

# Anexos de inscrição → Google Drive (não Cloudinary)
# Ver docs/google-drive-setup.md
# GOOGLE_DRIVE_FOLDER_ID=""
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"..."}'
# ou:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# GOOGLE_DRIVE_SHARE_EMAIL="elemos@unilicungo.ac.mz"

# Web3Forms — envio no browser (obrigatório no plano free; key é pública)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="2b13d06d-3b42-494a-9a82-84ca416fdeb3"

# Resend (opcional; envio server-side adicional)
# RESEND_API_KEY=""
# MAIL_FROM="IEUL MozInkub <noreply@seudominio.com>"

# Site da CyberCode360 (crédito no rodapé — actualizar quando online)
# NEXT_PUBLIC_CYBERCODE_URL="https://cybercode360.com"

# Opcional: pasta local sincronizada para backup SQLite (Windows)
# GDRIVE_BACKUP_DIR="C:/Users/<UTILIZADOR>/OneDrive/IEUL-Backups/sqlite"
